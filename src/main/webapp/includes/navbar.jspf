<%@ page import="Modelos.Cliente" %>
<%@ page import="Modelos.Admin" %>

<%
    Cliente clienteLogueado = (Cliente) session.getAttribute("clienteLogueado");
    Admin adminLogueado = (Admin) session.getAttribute("adminLogueado");
%>

<!-- Líneas de acento -->
<hr class="border-danger border-2 opacity-100 my-0">
<hr class="border-primary border-2 opacity-100 my-0">
<hr class="border-light border-2 opacity-100 my-0">

<nav class="navbar navbar-expand-lg navbar-dark bg-black border-bottom border-primary">
  <div class="container-fluid">

    <!-- LOGO / MARCA -->
    <a class="navbar-brand fw-bold"
       href="<%= request.getContextPath() %>/Inicio.jsp">
      &#x1F488; BARBERSHOP
    </a>

    
      <!-- Reloj Pills -->
	<div id="clockPills"
         class="d-none d-lg-flex align-items-center gap-1 ms-3"
         data-bs-toggle="tooltip"
         data-bs-placement="bottom"
         title="Hora actual">
      <span id="ck-h" class="badge rounded-pill bg-danger fs-6 px-3">00</span>
      <span class="text-white-50">:</span>
      <span id="ck-m" class="badge rounded-pill bg-primary fs-6 px-3">00</span>
      <span class="text-white-50">:</span>
      <span id="ck-s" class="badge rounded-pill bg-secondary fs-6 px-3">00</span>
      <span id="ck-ampm" class="badge rounded-pill text-bg-dark border border-light ms-1">AM</span>
    </div>

	    <div class="collapse navbar-collapse justify-content-end">


    <!-- Botón hamburguesa -->
    <button class="navbar-toggler" type="button"
            data-bs-toggle="collapse"
            data-bs-target="#menu"
            aria-controls="menu"
            aria-expanded="false"
            aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Menú -->
    <div id="menu" class="collapse navbar-collapse">
      <ul class="navbar-nav ms-auto align-items-lg-center gap-2 mt-3 mt-lg-0">

        <li class="nav-item">
          <a class="btn btn-danger btn-sm px-3"
             href="<%= request.getContextPath() %>/Inicio.jsp">Inicio</a>
        </li>

        <li class="nav-item">
          <a class="btn btn-primary btn-sm px-3"
             href="<%= request.getContextPath() %>/Servicios.jsp">Servicios</a>
        </li>

        <li class="nav-item">
          <a class="btn btn-danger btn-sm px-3"
             href="<%= request.getContextPath() %>/Horarios.jsp">Horarios</a>
        </li>

        <li class="nav-item">
          <a class="btn btn-primary btn-sm px-3"
             href="<%= request.getContextPath() %>/Barberos.jsp">Barberos</a>
        </li>

        <li class="nav-item">
          <a class="btn btn-danger btn-sm px-3"
             href="<%= request.getContextPath() %>/Contacto.jsp">Contacto</a>
        </li>

        <!-- Separador suave (solo desktop) -->
        <li class="nav-item d-none d-lg-block">
          <span class="text-white-50 mx-2">|</span>
        </li>

        <% if (clienteLogueado != null) { %>

          <!-- Cliente (DESKTOP) -->
          <li class="nav-item d-none d-lg-flex align-items-center gap-2">
            <span class="badge text-bg-dark border border-light">Cliente</span>
            <span class="text-white fw-semibold"><%= clienteLogueado.getNombre() %></span>
          </li>

          <!-- Cliente (MÓVIL) -->
          <li class="nav-item d-lg-none">
            <div class="text-center text-white-50 small">
              Cliente: <span class="text-white fw-semibold"><%= clienteLogueado.getNombre() %></span>
            </div>
          </li>

          <!-- Cerrar sesión -->
          <li class="nav-item">
            <a class="btn btn-outline-danger btn-sm px-3"
               href="<%= request.getContextPath() %>/LogoutController">
              Cerrar Sesion
            </a>
          </li>

        <% } else { %>

          <!-- Iniciar sesión -->
          <li class="nav-item">
            <a class="btn btn-outline-light btn-sm px-3 btn-login-cta"
               href="<%= request.getContextPath() %>/Login">
              Iniciar Sesion
            </a>
          </li>

        <% } %>

      </ul>
    </div>
  </div>
</nav>

<!-- JS del reloj -->
<script>
(function () {
  const $h = document.getElementById('ck-h');
  const $m = document.getElementById('ck-m');
  const $s = document.getElementById('ck-s');
  const $ampm = document.getElementById('ck-ampm');
  const $pills = document.getElementById('clockPills');
  let flipColors = false;

  const pad = n => (n < 10 ? '0' + n : '' + n);

  function tick() {
    const d = new Date();
    let hh = d.getHours();
    const mm = d.getMinutes();
    const ss = d.getSeconds();
    const ap = hh >= 12 ? 'PM' : 'AM';
    hh = hh % 12 || 12;

    $h.textContent = pad(hh);
    $m.textContent = pad(mm);
    $s.textContent = pad(ss);
    $ampm.textContent = ap;

    if (ss === 0) {
      flipColors = !flipColors;
      $h.classList.toggle('bg-danger',  flipColors);
      $h.classList.toggle('bg-primary', !flipColors);
      $m.classList.toggle('bg-primary',  flipColors);
      $m.classList.toggle('bg-danger',  !flipColors);
    }
  }

  tick();
  setInterval(tick, 1000);

  if (window.bootstrap && $pills) {
    new bootstrap.Tooltip($pills);
  }
})();
</script>
